# .env.example - Configuración requerida para producción

# 1. Base de Datos (Supabase)
# Estas claves se obtienen del panel de Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://tuid.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica

# 2. Dominio de la Aplicación
# URL canónica en producción sin slash final. 
# Utilizada para la generación de QRs, redirecciones y links absolutos.
# Ejemplo: https://sifcards.com
VITE_APP_DOMAIN=https://tudominio.com

# 3. Buckets de Almacenamiento (Supabase Storage)
# Nombres de los buckets donde se guardan las imágenes (deben ser públicos)
VITE_SUPABASE_AVATARS_BUCKET=avatars
VITE_SUPABASE_BANNERS_BUCKET=banners
